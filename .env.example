# Copy this to .env and fill in real values. NEVER commit .env.
# For production: use CI/CD secrets or a secrets manager.

# PostgreSQL
POSTGRES_USER=privacy_user
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=privacy_aware_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_URL=postgresql://privacy_user:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/privacy_aware_db
DATABASE_URL=postgresql://privacy_user:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/privacy_aware_db

# JWT (use different values for each)
JWT_SECRET=CHANGE_ME_JWT_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_different_from_JWT_SECRET_64_chars

# Token expiry
DEV_TOKEN_EXPIRES_IN=7d

# OpenAI
OPENAI_API_KEY=CHANGE_ME_OPENAI_API_KEY

# Google OAuth
GOOGLE_CLIENT_ID=CHANGE_ME_google_client_id
GOOGLE_CLIENT_SECRET=CHANGE_ME_google_client_secret

# MinIO object storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password_min_20_chars
MINIO_ACCESS_KEY=CHANGE_ME_access_key
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_PORT=9000
MINIO_BUCKET=privacy-docs
MINIO_HOST=minio
MINIO_ENDPOINT=minio:9000
MINIO_HOST_URL=http://localhost:9000

# ChromaDB / Vector DB
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMADB_HOST=chromadb
CHROMADB_PORT=8000
CHROMADB_URL=http://chromadb:8000
CHROMADB_COLLECTION=privacy_documents

# Ollama (local LLM / embeddings)
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# Internal service authentication (gateway -> worker)
WORKER_INTERNAL_KEY=CHANGE_ME_WORKER_INTERNAL_KEY
WORKER_URL=http://worker:8001
WORKER_PORT=8001

# Redis
REDIS_URL=redis://redis:6379/0

# Security
QUERY_HASH_SALT=CHANGE_ME_QUERY_HASH_SALT
AES_MASTER_KEY=CHANGE_ME_AES_MASTER_KEY

# Privacy / Differential Privacy
DP_ENABLED=false
RETENTION_DAYS=90

# CORS (comma-separated origins for production)
CORS_ORIGIN=https://yourdomain.com
CORS_ORIGINS=https://yourdomain.com

# Frontend URL
FRONTEND_URL=https://yourdomain.com

# Application
NODE_ENV=production
API_PORT=3001
PRIMARY_MODEL=gpt-4o-mini
PRIMARY_EMBED=text-embedding-3-small
LOCAL_CHAT_MODEL=llama3.2
LOCAL_EMBED_MODEL=nomic-embed-text
TOP_K=5
DB_MIN_CONN=2
DB_MAX_CONN=20
STRICT_RAG_MODE=true
USE_OPENAI_CHAT=true

# Frontend API URLs (used by Vite / React build)
VITE_API_URL=http://localhost:3001
VITE_CHROMA_ENDPOINT=http://localhost:8000
VITE_MINIO_ENDPOINT=http://localhost:9000
VITE_OLLAMA_ENDPOINT=http://localhost:11434
REACT_APP_API_URL=http://localhost:3001
REACT_APP_CHROMA_ENDPOINT=http://localhost:8000
REACT_APP_MINIO_ENDPOINT=http://localhost:9000
REACT_APP_OLLAMA_ENDPOINT=http://localhost:11434

# Dev only (remove in production)
DEV_AUTH_KEY=CHANGE_ME_dev_key
