# Copy this file to .env and fill in your actual values
# DO NOT COMMIT .env file to version control

# Postgres / Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<your-secure-password>
POSTGRES_DB=privacy_docs
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:<password>@postgres:5432/privacy_docs
POSTGRES_URL=${DATABASE_URL}

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO (object storage)
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=privacy-documents
MINIO_ACCESS_KEY=<your-minio-access-key>
MINIO_SECRET_KEY=<your-minio-secret-key>
MINIO_ROOT_USER=<your-root-user>
MINIO_ROOT_PASSWORD=<your-root-password>
MINIO_HOST_URL=http://localhost:9000

# ChromaDB
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMADB_URL=http://chromadb:8000
CHROMADB_COLLECTION=privacy_documents

# Ollama / LLM
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=mistral
OLLAMA_EMBED_MODEL=mxbai-embed-large

# API & Worker
API_PORT=3001
WORKER_PORT=8001
WORKER_URL=http://worker:8001
NODE_ENV=development

# Security / App secrets
JWT_SECRET=<your-jwt-secret-key>
QUERY_HASH_SALT=<your-hash-salt>

# OpenAI Configuration
OPENAI_API_KEY=<your-openai-api-key>
USE_OPENAI_CHAT=TRUE
STRICT_RAG_MODE=TRUE
PRIMARY_MODEL=gpt-4o-mini

# Google OAuth Configuration
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>

# Frontend (Vite environment variables)
VITE_API_URL=http://api:3001
VITE_MINIO_ENDPOINT=http://minio:9000
VITE_CHROMA_ENDPOINT=http://chromadb:8000
VITE_OLLAMA_ENDPOINT=http://ollama:11434

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
CORS_ORIGIN=http://localhost:3000

# Analytics
TOP_K=5
